.venv/
venv/
# The tracked controller_client source MUST stay in the server image:
# projects/controller_protocol.py imports controller_client.protocol, and
# generate_controller_client_zip() reads the whole tree to build the download.
# Only the heavy per-machine runtime artifacts are excluded (they are also
# .gitignored, but .dockerignore needs its own entries).
controller_client/.venv/
controller_client/venv/
controller_client/.env
controller_client/.pytest_cache/
controller_client/.mypy_cache/
controller_client/logs/
# Side-by-side installs and start script left by a runner self-update run
# from this checkout (they also hold a copy of controller_client/.env).
test-runner-*/
start-test-runner.sh
start-test-runner.cmd
# Same for vision_worker: the server imports vision_worker.protocol, so the
# source stays; its venv, model weights and .env are per-machine artifacts.
vision_worker/.venv/
vision_worker/venv/
vision_worker/omniparser/weights/
vision_worker/.env
vision_worker/.mypy_cache/
.git/
__pycache__/
*.pyc
.env
media/
private_media/
staticfiles/
docs/
.claude/
.mypy_cache/
.pytest_cache/
node_modules/
ui-prototype/
