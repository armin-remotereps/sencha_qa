CONTROLLER_HOST=localhost
CONTROLLER_PORT=8000
CONTROLLER_API_KEY=your-api-key-here
CONTROLLER_RECONNECT_INTERVAL=5
CONTROLLER_MAX_RECONNECT_ATTEMPTS=10
CONTROLLER_LOG_LEVEL=INFO
# Folder emptied by the server's cleanup_environment action between test cases. The client never deletes its own install dir or venv, but keep it out of this folder anyway.
CONTROLLER_CLEANUP_DIR=~/Downloads
# OMNIPARSER_WEIGHTS_DIR=   # leave unset to use the default (controller_client/omniparser/weights) — python-decouple treats a present-but-empty value as "", not "unset", so this must stay commented out rather than blank
OMNIPARSER_BOX_THRESHOLD=0.05
OMNIPARSER_IOU_THRESHOLD=0.7
OMNIPARSER_CAPTION_BATCH_SIZE=64
# Upper bound (bytes) for one serialized find_element_result WebSocket message; the annotated screenshot is downscaled until it fits. Keep it below the server's WebSocket message limit.
OMNIPARSER_MAX_RESULT_BYTES=8388608
