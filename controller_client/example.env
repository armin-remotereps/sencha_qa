CONTROLLER_HOST=localhost
CONTROLLER_PORT=8000
CONTROLLER_API_KEY=your-api-key-here
CONTROLLER_RECONNECT_INTERVAL=5
# Reconnect backoff doubles from CONTROLLER_RECONNECT_INTERVAL up to this many seconds.
CONTROLLER_RECONNECT_MAX_INTERVAL=60
# 0 = retry forever.
CONTROLLER_MAX_RECONNECT_ATTEMPTS=0
CONTROLLER_LOG_LEVEL=INFO
# Folder emptied by the server's cleanup_environment action between test cases. The client never deletes its own install dir or venv, but keep it out of this folder anyway.
CONTROLLER_CLEANUP_DIR=~/Downloads
