CONTROLLER_HOST=localhost
CONTROLLER_PORT=8000
CONTROLLER_API_KEY=your-api-key-here
# Connect to the server through this proxy: socks5h://, socks5://, socks4a://, socks4://, http:// or https://, optionally with user:pass@ (e.g. socks5h://127.0.0.1:1080, http://user:pass@proxy:3128). socks5h resolves the server name at the proxy, socks5 on this machine. Empty = the system proxy settings.
CONTROLLER_PROXY=
CONTROLLER_RECONNECT_INTERVAL=5
# Reconnect backoff doubles from CONTROLLER_RECONNECT_INTERVAL up to this many seconds.
CONTROLLER_RECONNECT_MAX_INTERVAL=60
# 0 = retry forever.
CONTROLLER_MAX_RECONNECT_ATTEMPTS=0
CONTROLLER_LOG_LEVEL=INFO
# Folder emptied by the server's cleanup_environment action between test cases. The client never deletes its own install dir or venv, but keep it out of this folder anyway.
CONTROLLER_CLEANUP_DIR=~/Downloads
# Show a window on this machine where a person can answer Human in the loop steps (needs tkinter). false = answer on the web only.
CONTROLLER_PERSON_WINDOW=true
# Your Punk Hazard email: steps answered in the window are recorded as yours when it belongs to an active member of the project. Blank = "a person at the Test Runner"; an interactive start asks for it once.
CONTROLLER_PERSON_EMAIL=
# Base text size of that window in points (10-28). A-/A+ in the window change it until the window restarts.
CONTROLLER_PERSON_WINDOW_TEXT_SIZE=14
# Manual runs: screenshots wait in controller_client/manual_spool/ until they are uploaded after the tester hands a case in. At this size (in MB, at least 64) the window takes no new screenshots until the uploads catch up.
CONTROLLER_MANUAL_SPOOL_MAX_MB=2048
