CONTROLLER_HOST=localhost
CONTROLLER_PORT=8000
# This Test Runner's token (shown once on the Test Runners page; a downloaded Test Runner has it already). It signs the runner in as yours: keep it secret.
CONTROLLER_RUNNER_TOKEN=your-runner-token-here
# The runner's name, for display only (logs and the window title until the server names it).
CONTROLLER_RUNNER_NAME=
# Connect to the server through this proxy: socks5h://, socks5://, socks4a://, socks4://, http:// or https://, optionally with user:pass@ (e.g. socks5h://127.0.0.1:1080, http://user:pass@proxy:3128). socks5h resolves the server name at the proxy, socks5 on this machine. Empty = the system proxy settings.
CONTROLLER_PROXY=
CONTROLLER_RECONNECT_INTERVAL=5
# Reconnect backoff doubles from CONTROLLER_RECONNECT_INTERVAL up to this many seconds.
CONTROLLER_RECONNECT_MAX_INTERVAL=60
# 0 = retry forever.
CONTROLLER_MAX_RECONNECT_ATTEMPTS=0
CONTROLLER_LOG_LEVEL=INFO
# Folder emptied by the server's cleanup_environment action between test cases. The client never deletes its own install dir or venv, but keep it out of this folder anyway.
CONTROLLER_CLEANUP_DIR=~/Downloads
# Show a window on this machine where a person can answer Human in the loop steps (needs tkinter). false = answer on the web only.
CONTROLLER_PERSON_WINDOW=true
# Base text size of that window in points (10-28). A-/A+ in the window change it until the window restarts.
CONTROLLER_PERSON_WINDOW_TEXT_SIZE=14
# Manual runs: system-wide key combinations that mark the current step Pass or Fail with a screenshot while a case is claimed and not paused (the Manual run tab shows them). false = use the tab's buttons only.
CONTROLLER_MANUAL_SHORTCUTS=true
# Manual runs: screenshots wait in controller_client/manual_spool/ until they are uploaded after the tester hands a case in. At this size (in MB, at least 64) the window takes no new screenshots until the uploads catch up.
CONTROLLER_MANUAL_SPOOL_MAX_MB=2048
# Web browser layer (Chrome, Edge, Firefox, Safari through their WebDriver drivers): true lets the runner download the matching chromedriver, msedgedriver or geckodriver from the browser vendor when it is missing; false uses only drivers on PATH or already cached.
CONTROLLER_WEB_DRIVER_DOWNLOAD=true
# What this Test Runner drives: desktop (this computer), android or ios (one phone, tablet, emulator or simulator attached to this computer, driven through Appium). ios needs a Mac with Xcode. A phone target needs Node.js 22.22.2+ (or 24.15+), Appium 3 (npm i -g appium@3) and its driver (appium driver install uiautomator2 / xcuitest); check with: python -m controller_client.diagnose --mobile
CONTROLLER_TARGET=desktop
# Serial (Android, as in `adb devices`) or UDID (iOS) of the device to drive. Blank = an interactive start lists the connected devices, asks and saves the answer here; a start without a terminal takes the only connected device.
CONTROLLER_DEVICE=
# URL of an Appium server you run yourself (e.g. http://127.0.0.1:4723). Blank = the Test Runner starts its own Appium on 127.0.0.1 and stops it on exit.
CONTROLLER_APPIUM_URL=
# Command that starts Appium when CONTROLLER_APPIUM_URL is blank.
CONTROLLER_APPIUM_COMMAND=appium
# iPhones and iPads (not simulators): WebDriverAgent is signed with your Apple Team ID and signing identity, or set CONTROLLER_IOS_PREINSTALLED_WDA=true and CONTROLLER_IOS_WDA_BUNDLE_ID to use a WebDriverAgent you installed on the device yourself.
CONTROLLER_IOS_TEAM_ID=
CONTROLLER_IOS_SIGNING_ID=Apple Development
CONTROLLER_IOS_WDA_BUNDLE_ID=
CONTROLLER_IOS_PREINSTALLED_WDA=false
