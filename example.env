SECRET_KEY=your-secret-key-here
# Fernet key for encrypting per-project secrets (TestRail API keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=generate-a-fernet-key-and-paste-it-here
DEBUG=True
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://sench.remotereps.com

# Database
DB_NAME=auto_tester
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery workers (run these in separate terminals):
# celery -A auto_tester worker -Q upload -l info -n upload@%h
# celery -A auto_tester worker -Q execution -l info -n execution@%h
# celery -A auto_tester worker -Q notify -l info -n notify@%h
# celery -A auto_tester worker -Q assist -l info -n assist@%h

# OpenAI API (shared credentials for all OpenAI-routed calls)
OPENAI_API_KEY=your-openai-api-key
# Must be the Responses endpoint; Chat Completions rejects tools while the model reasons.
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Every LLM role — agent, orchestrator, sub-agent, summarizer, refiner and
# vision — runs on this one model. Output token ceilings are fixed in
# agents/services/llm_config.py and temperature is never sent.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT=900
# auto | concise | detailed; needs a verified OpenAI org. Blank = no summary.
OPENAI_REASONING_SUMMARY=auto

# Agent
AGENT_MAX_ITERATIONS=300
AGENT_TIMEOUT_SECONDS=600
# Longest tool result (chars) the model sees; longer ones keep head and tail
AGENT_TOOL_RESULT_MAX_CHARS=100000
# Machine setup (S0) chat: max main-agent steps (delegations and project-data
# reads, not sub-task steps) and seconds per user message
MACHINE_SETUP_MAX_ITERATIONS=200
MACHINE_SETUP_TURN_TIMEOUT_SECONDS=3600
# One delegated setup sub-task: budget clamped to [MIN, MAX] and to what the turn
# has left. Keep this ordering:
# one element search (typically 2-6s) < MIN <= TIMEOUT_SECONDS <= MAX <= TURN_TIMEOUT
MACHINE_SETUP_SUBTASK_TIMEOUT_SECONDS=900
MACHINE_SETUP_SUBTASK_MIN_TIMEOUT_SECONDS=150
MACHINE_SETUP_SUBTASK_MAX_TIMEOUT_SECONDS=1800
MACHINE_SETUP_SUBTASK_MAX_ITERATIONS=100
# Largest document (bytes) a person can attach to a main chat message
MACHINE_SETUP_DOCUMENT_MAX_BYTES=262144

# SearXNG (metasearch engine)
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_MAX_RESULTS=5
SEARXNG_REQUEST_TIMEOUT=15

# Search page fetching (trafilatura)
SEARCH_FETCH_PAGE_COUNT=3
SEARCH_PAGE_MAX_LENGTH=2000
SEARCH_PAGE_FETCH_TIMEOUT=10

# Controller
CONTROLLER_SERVER_HOST=localhost
CONTROLLER_SERVER_PORT=8000
# How long a running test waits for the Test Runner to reconnect. Each test case may
# wait at most twice this in total; the wait does not consume agent time.
CONTROLLER_RECONNECT_GRACE_SECONDS=300
INTERACTIVE_CMD_TIMEOUT_SECONDS=300
CLEANUP_TIMEOUT_SECONDS=30
# Budget for closing the apps a Failed/Blocked case left open; 0 disables it.
CASE_TEARDOWN_TIMEOUT_SECONDS=120
# Human in the loop: budget of the agent that confirms a person's report of a step.
PERSON_STEP_CONFIRM_TIMEOUT_SECONDS=120
# Human in the loop: characters of pasted and check output kept as a failed step's evidence.
PERSON_EVIDENCE_OUTPUT_MAX_CHARS=4000
# Human in the loop: Mark failed / Mark blocked let the agent run one read-only check
# for evidence (True) or only take a screenshot (False).
PERSON_EVIDENCE_LLM=True
# Human in the loop: timeout of the AI answering a person's question about a step.
PERSON_STEP_QUESTION_TIMEOUT_SECONDS=120
# Test Runner self-update: seconds before an update with no outcome counts as expired.
# Must be at least the runner's update deadline (3600) + 60; the default is 3900.
RUNNER_UPDATE_TIMEOUT_SECONDS=3900

# Visual engine (vision workers running OmniParser on a GPU machine; see vision_worker/README.md)
# Shared secret every vision worker sends. Empty rejects every worker. Generate with:
# python -c "import secrets;print(secrets.token_urlsafe(32))"
VISION_WORKER_TOKEN=
# One element search worst case: screenshot (3 x 30s) + VISION_WORKER_WAIT_SECONDS
# + VISION_PARSE_BUDGET_SECONDS; typically 2-6s on a GPU. Keep the typical case
# well below SUB_AGENT_MIN_TIMEOUT_SECONDS.
VISION_PARSE_ATTEMPT_TIMEOUT=45
VISION_PARSE_BUDGET_SECONDS=90
VISION_WORKER_WAIT_SECONDS=30
VISION_WORKER_READY_TIMEOUT=600
# Keep at least 3x the worker's 30s heartbeat.
VISION_WORKER_STALE_SECONDS=90

# Notifications through ntfy (https://ntfy.sh): Need help and Failed case alerts.
# Each user turns notifications on and subscribes to their own random topic in the
# ntfy app. Leave NTFY_SERVER_URL empty to turn notifications off.
# On public ntfy.sh all topics are public: anyone who knows a topic can read and
# publish to it, so the random topic is the only protection. The free tier allows
# 250 messages per day per server IP.
# Recommended: self-host ntfy with `auth-default-access: deny-all`, create a
# publisher with `ntfy token add` and put the token in NTFY_ACCESS_TOKEN, set
# `upstream-base-url: https://ntfy.sh` (instant iOS delivery) and `behind-proxy`
# when it runs behind nginx.
NTFY_SERVER_URL=https://ntfy.sh
# Optional access token (tk_...); keep it secret and use an https server URL.
NTFY_ACCESS_TOKEN=
# Optional topic prefix, at most 16 characters of [-_A-Za-z0-9], e.g. punkhazard-
NTFY_TOPIC_PREFIX=
NTFY_REQUEST_TIMEOUT=10

# Public origin of this site, used for notification click links (empty = no link).
# e.g. SITE_URL=https://sench.remotereps.com
SITE_URL=

# Morning digest of the night's Night runs: the hour (0-23, UTC) it is pushed, and
# how many hours back a Night run may have started to be included.
NIGHT_DIGEST_HOUR=7
NIGHT_DIGEST_LOOKBACK_HOURS=24

# Test sessions: one left open longer than this many hours is closed
# automatically (at its start + this). 0 never closes sessions automatically.
TEST_SESSION_MAX_HOURS=12

# Screenshots attached by "Send checked to TestRail" (Failed/Blocked only): the
# last N of each failing step, and at most MAX per case.
TESTRAIL_EVIDENCE_SHOTS_PER_STEP=3
TESTRAIL_EVIDENCE_MAX_SHOTS=10

# Orchestrator (sub-agent architecture)
ORCHESTRATOR_MAX_SUBTASKS=30
ORCHESTRATOR_MAX_RECOVERY_ATTEMPTS=1
# Knowledge base tool rounds the planner may take (only in projects with ready
# knowledge base items; 0 turns the loop off) and the loop's wall-clock cap.
ORCHESTRATOR_PLAN_MAX_TOOL_ROUNDS=4
ORCHESTRATOR_PLAN_TIMEOUT_SECONDS=180

# Sub-Agent
SUB_AGENT_MAX_ITERATIONS=300
# Per-sub-task wall-clock budget. The orchestrator estimates one per sub-task;
# the server clamps it to [MIN, MAX] and uses TIMEOUT_SECONDS when none is given.
# Keep this ordering: one element search (typically 2-6s) < MIN <= TIMEOUT_SECONDS <= MAX
# < execute_test_run_case's soft time limit (1800s). MAX bounds ONE sub-task; a run
# with several long sub-tasks can still hit the Celery limit.
SUB_AGENT_TIMEOUT_SECONDS=180
SUB_AGENT_MIN_TIMEOUT_SECONDS=150
SUB_AGENT_MAX_TIMEOUT_SECONDS=900
# When a step, recovery or restore sub-agent's budget runs out it gets one last
# LLM turn with no tools to answer RESULT: PASS/FAIL; this caps that call (adds
# up to this much per timed-out sub-agent). 0 disables the final turn.
AGENT_FINAL_ANSWER_TIMEOUT_SECONDS=90

# Project knowledge base. Files are stored privately (never under MEDIA_ROOT;
# docker-compose mounts the KNOWLEDGE_BASE volume at /src/private_media) and
# read by the knowledge-celery worker:
# celery -A auto_tester worker -Q knowledge -l info -n knowledge@%h --concurrency=2 --max-memory-per-child=1048576
# Default <project>/private_media/knowledge_base; a relative path is taken from
# the project directory. Must not be inside MEDIA_ROOT.
# KNOWLEDGE_BASE_ROOT=/src/private_media/knowledge_base
KNOWLEDGE_BASE_MAX_FILE_BYTES=26214400
# At most 100 (DATA_UPLOAD_MAX_NUMBER_FILES).
KNOWLEDGE_BASE_MAX_FILES_PER_UPLOAD=20
# Per project, archives and their members included.
KNOWLEDGE_BASE_MAX_PROJECT_BYTES=1073741824
KNOWLEDGE_BASE_MAX_ITEM_CHARS=5000000
KNOWLEDGE_BASE_ARCHIVE_MAX_MEMBERS=500
# Also caps what is read out of .docx / .xlsx containers.
KNOWLEDGE_BASE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=268435456
KNOWLEDGE_BASE_PDF_MAX_PAGES=2000
KNOWLEDGE_BASE_SHEET_MAX_CELLS=2000000
KNOWLEDGE_BASE_EXTRACT_TIME_LIMIT_SECONDS=600
# Bytes one project may upload per hour (at least the file limit).
KNOWLEDGE_BASE_UPLOAD_BYTES_PER_HOUR=2147483648
KNOWLEDGE_BASE_ACCEPT_7Z=True
