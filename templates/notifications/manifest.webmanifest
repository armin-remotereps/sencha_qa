{% load static %}{
  "name": "{{ brand_name|default:'Punk Hazard'|escapejs }}",
  "short_name": "{{ brand_name|default:'Punk Hazard'|escapejs }}",
  "description": "{{ brand_tagline|default:''|escapejs }}",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1118",
  "theme_color": "#0b1118",
  "icons": [
    {"src": "{% static 'branding/punk-hazard-icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'branding/punk-hazard-icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ]
}
