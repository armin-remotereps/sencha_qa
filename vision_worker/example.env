# Copy to vision_worker/.env (setup.sh / setup.ps1 do it for you) and fill in.
# Never commit .env: it holds the shared worker token.

# Full WebSocket URL of the server's vision worker endpoint. Must be wss://
# unless the host is loopback or on a private network.
VISION_SERVER_URL=wss://panel.example.com/ws/vision-worker/
# Set to true only to allow ws:// to a public host (screenshots then travel unencrypted).
VISION_ALLOW_INSECURE=false
# Must equal VISION_WORKER_TOKEN in the server's .env.
VISION_WORKER_TOKEN=change-me
# Stable, unique name per worker (one per GPU). Leave unset to use <hostname>-<device>.
# A second worker connecting with the same name replaces the first one.
# VISION_WORKER_NAME=my-pc-gpu0
# auto (cuda, then mps, then cpu), cuda, mps or cpu. Pick a GPU with CUDA_VISIBLE_DEVICES.
VISION_DEVICE=auto
# Requests allowed to wait behind the one being parsed; beyond that the worker answers BUSY
# and the server tries another worker.
VISION_MAX_QUEUE=1
# Upper bound (bytes) for one serialized parse result; the annotated image is downscaled
# until it fits. Keep it below the server's WebSocket message limit (32 MiB).
VISION_MAX_RESULT_BYTES=8388608
# Reconnect backoff doubles from VISION_RECONNECT_INTERVAL up to VISION_RECONNECT_MAX_INTERVAL seconds.
VISION_RECONNECT_INTERVAL=5
VISION_RECONNECT_MAX_INTERVAL=60
VISION_LOG_LEVEL=INFO

# OMNIPARSER_WEIGHTS_DIR=   # leave unset to use vision_worker/omniparser/weights (Docker sets /weights) — python-decouple treats a present-but-empty value as "", so keep it commented out rather than blank
OMNIPARSER_BOX_THRESHOLD=0.05
OMNIPARSER_IOU_THRESHOLD=0.7
OMNIPARSER_CAPTION_BATCH_SIZE=64
